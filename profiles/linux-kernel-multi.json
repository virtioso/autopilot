{
  "name": "linux-kernel-multi",
  "chain": {
    "entry": "map_tty0",
    "steps": {
      "map_tty0": {
        "type": "map_source",
        "source": "tty0",
        "tty": "env:AUTOPILOT_TTY0",
        "log": "console/tty0.jsonl",
        "outcomes": [
          { "label": "ok", "next": "window1" }
        ],
        "on_timeout": "fail"
      },
      "window1": {
        "type": "map_window",
        "window": 1,
        "source": "tty0",
        "title": "TTY0",
        "outcomes": [
          { "label": "ok", "next": "relay_power" }
        ],
        "on_timeout": "fail"
      },
      "relay_power": {
        "type": "relay",
        "outcomes": [
          { "label": "ok", "next": "boot_stock" }
        ],
        "on_timeout": "fail"
      },
      "boot_stock": {
        "type": "boot_menu",
        "source": "tty0",
        "boot_option": "1",
        "outcomes": [
          { "label": "menu", "pattern": "Press any .*boot default|Press ESCAPE for boot options|Enter to continue boot", "source": "tty0", "next": "wait_stock_prompt" }
        ],
        "on_timeout": "fail"
      },
      "wait_stock_prompt": {
        "type": "wait_pattern",
        "timeout_s": 180,
        "outcomes": [
          { "label": "prompt", "pattern": "ubuntu@tegra-ubuntu:~\\$|tegra-ubuntu login:", "source": "tty0", "next": "upload_kernel" }
        ],
        "on_timeout": "fail"
      },
      "upload_kernel": {
        "type": "upload_kernel",
        "target_user": "root",
        "target_ip": "{target_ip}",
        "target_path": "/boot/Image-{kernel_release}",
        "outcomes": [
          { "label": "ok", "next": "reboot_test" }
        ],
        "on_timeout": "fail"
      },
      "reboot_test": {
        "type": "reboot",
        "method": "ssh",
        "target_user": "root",
        "target_ip": "{target_ip}",
        "outcomes": [
          { "label": "ok", "next": "boot_test" }
        ],
        "on_timeout": "fail"
      },
      "boot_test": {
        "type": "boot_menu",
        "source": "tty0",
        "boot_option": "2",
        "outcomes": [
          { "label": "menu", "pattern": "Press any .*boot default|Press ESCAPE for boot options|Enter to continue boot", "source": "tty0", "next": "wait_kernel" }
        ],
        "on_timeout": "fail"
      },
      "wait_kernel": {
        "type": "wait_pattern",
        "timeout_s": 300,
        "outcomes": [
          { "label": "panic", "pattern": "Kernel panic", "source": "tty0", "next": "fork_recovery_fail" },
          { "label": "smmu", "pattern": "Unexpected global fault|callbacks suppressed", "source": "tty0", "next": "fork_recovery_fail" },
          { "label": "shell", "pattern": "ubuntu@tegra-ubuntu:~\\$|tegra-ubuntu login:", "source": "tty0", "next": "fork_recovery_pass" }
        ],
        "on_timeout": "fork_recovery_fail"
      },
      "fork_recovery_pass": {
        "type": "fork",
        "chain": "recovery_boot",
        "outcomes": [
          { "label": "started", "next": "pass" }
        ],
        "on_timeout": "pass"
      },
      "fork_recovery_fail": {
        "type": "fork",
        "chain": "recovery_boot",
        "outcomes": [
          { "label": "started", "next": "fail" }
        ],
        "on_timeout": "fail"
      },
      "pass": { "type": "pass" },
      "fail": { "type": "fail" }
    },
    "subchains": {
      "recovery_boot": {
        "entry": "boot_stock",
        "steps": {
          "boot_stock": {
            "type": "boot_menu",
            "source": "tty0",
            "boot_option": "1",
            "outcomes": [
              { "label": "menu", "pattern": "Press any .*boot default|Press ESCAPE for boot options|Enter to continue boot", "source": "tty0", "next": "wait_prompt" }
            ],
            "on_timeout": "fail"
          },
          "wait_prompt": {
            "type": "wait_pattern",
            "timeout_s": 180,
            "outcomes": [
              { "label": "prompt", "pattern": "ubuntu@tegra-ubuntu:~\\$|tegra-ubuntu login:", "source": "tty0", "next": "pass" }
            ],
            "on_timeout": "fail"
          },
          "pass": { "type": "pass" },
          "fail": { "type": "fail" }
        }
      }
    }
  }
}
