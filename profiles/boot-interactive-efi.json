{
  "name": "boot-interactive-efi",
  "chain": {
    "entry": "map_tty0",
    "steps": {
      "map_tty0": {
        "type": "map_source",
        "source": "tty0",
        "tty": "env:AUTOPILOT_TTY0",
        "log": "console/tty0.jsonl",
        "outcomes": [
          { "label": "ok", "next": "window1" }
        ],
        "on_timeout": "fail"
      },
      "window1": {
        "type": "map_window",
        "window": 1,
        "source": "tty0",
        "title": "TTY0",
        "outcomes": [
          { "label": "ok", "next": "relay_power" }
        ],
        "on_timeout": "fail"
      },
      "relay_power": {
        "type": "relay",
        "outcomes": [
          { "label": "ok", "next": "boot_stock" }
        ],
        "on_timeout": "fail"
      },
      "boot_stock": {
        "type": "boot_menu",
        "source": "tty0",
        "boot_option": "1",
        "outcomes": [
          { "label": "menu", "pattern": "Press any .*boot default|Press ESCAPE for boot options|Enter to continue boot", "source": "tty0", "next": "wait_stock_prompt" }
        ],
        "on_timeout": "fail"
      },
      "wait_stock_prompt": {
        "type": "wait_pattern",
        "timeout_s": 180,
        "outcomes": [
          { "label": "prompt", "pattern": "ubuntu@tegra-ubuntu:~\\$|tegra-ubuntu login:", "source": "tty0", "next": "upload_efi" }
        ],
        "on_timeout": "fail"
      },
      "upload_efi": {
        "type": "upload_efi",
        "target_user": "root",
        "target_ip": "{target_ip}",
        "target_path": "/boot/efi/{binary_name}",
        "outcomes": [
          { "label": "ok", "next": "reboot_efi" }
        ],
        "on_timeout": "fail"
      },
      "reboot_efi": {
        "type": "reboot",
        "method": "ssh",
        "target_user": "root",
        "target_ip": "{target_ip}",
        "outcomes": [
          { "label": "ok", "next": "boot_efi" }
        ],
        "on_timeout": "fail"
      },
      "boot_efi": {
        "type": "boot_menu",
        "source": "tty0",
        "boot_option": "2",
        "outcomes": [
          { "label": "menu", "pattern": "Press any .*boot default|Press ESCAPE for boot options|Enter to continue boot", "source": "tty0", "next": "wait_efi" }
        ],
        "on_timeout": "fail"
      },
      "wait_efi": {
        "type": "wait_pattern",
        "timeout_s": 180,
        "outcomes": [
          { "label": "ok", "pattern": "seL4|ELF-loader|driver-vm login:|root@driver-vm:~#", "source": "tty0", "next": "interactive" }
        ],
        "on_timeout": "fail"
      },
      "interactive": {
        "type": "interactive_console",
        "exit_after_shell": true,
        "sessions": [
          { "name": "tty0", "port": "/dev/ttyACM0", "source": "tty0", "profile": "ubuntu-22" }
        ],
        "outcomes": [
          { "label": "ok", "next": "fork_recovery_pass" }
        ],
        "on_timeout": "fail"
      },
      "fork_recovery_pass": {
        "type": "fork",
        "chain": "recovery_boot",
        "outcomes": [
          { "label": "started", "next": "pass" }
        ],
        "on_timeout": "pass"
      },
      "pass": { "type": "pass" },
      "fail": { "type": "fail" }
    },
    "subchains": {
      "recovery_boot": {
        "entry": "boot_stock",
        "steps": {
          "boot_stock": {
            "type": "boot_menu",
            "source": "tty0",
            "boot_option": "1",
            "outcomes": [
              { "label": "menu", "pattern": "Press any .*boot default|Press ESCAPE for boot options|Enter to continue boot", "source": "tty0", "next": "wait_prompt" }
            ],
            "on_timeout": "fail"
          },
          "wait_prompt": {
            "type": "wait_pattern",
            "timeout_s": 180,
            "outcomes": [
              { "label": "prompt", "pattern": "ubuntu@tegra-ubuntu:~\\$|tegra-ubuntu login:", "source": "tty0", "next": "pass" }
            ],
            "on_timeout": "fail"
          },
          "pass": { "type": "pass" },
          "fail": { "type": "fail" }
        }
      }
    }
  }
}
