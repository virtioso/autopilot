{
  "entry": "wait_vm0_login_or_shell",
  "steps": {
    "wait_vm0_login_or_shell": {
      "type": "wait_pattern",
      "timeout_s": 300,
      "outcomes": [
        {
          "label": "ftrace_overflow",
          "pattern": "FTRACE: Storage full",
          "source": "tty0",
          "next": "emit_ftrace_overflow_marker"
        },
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "arm_ftrace_late"
        },
        {
          "label": "driver_vm_login",
          "pattern": "driver-vm login:|login:",
          "source": "tty0",
          "next": "send_root_login"
        }
      ],
      "on_timeout": "fail"
    },
    "send_root_login": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "root",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_vm0_shell"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_vm0_shell": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "ftrace_overflow",
          "pattern": "FTRACE: Storage full",
          "source": "tty0",
          "next": "emit_ftrace_overflow_marker"
        },
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "arm_ftrace_late"
        }
      ],
      "on_timeout": "fail"
    },
    "arm_ftrace_late": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "/usr/bin/hyp-ftrace-ctl arm",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_arm_ftrace_result"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_arm_ftrace_result": {
      "type": "wait_pattern",
      "start_from": "tail",
      "timeout_s": 20,
      "outcomes": [
        {
          "label": "arm_failed",
          "pattern": "AUTOPILOT_FAIL: HYP_FTRACE_ARM_CMD_FAILED|AUTOPILOT_FAIL: HYP_FTRACE_ARM_",
          "source": "tty0",
          "next": "fail"
        },
        {
          "label": "shell_prompt",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "run_qemu_rnd_helper"
        }
      ],
      "on_timeout": "fail"
    },
    "run_qemu_rnd_helper": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "TTY_DEV=$(tty); if ! command -v screen >/dev/null 2>&1; then echo 'AUTOPILOT_FAIL: SCREEN_NOT_FOUND'; false; fi; screen -S vm1-uservm -X quit >/dev/null 2>&1 || true; screen -dmS vm1-uservm /bin/sh -lc 'exec qemu-rnd-helper'; sleep 1; screen -ls | grep -q '[.]vm1-uservm[[:space:]]' || { echo 'AUTOPILOT_FAIL: SCREEN_SESSION_START_FAILED'; false; }; screen -S vm1-uservm -p 0 -X logfile \"$TTY_DEV\" || { echo 'AUTOPILOT_FAIL: SCREEN_LOGFILE_SET_FAILED'; false; }; screen -S vm1-uservm -p 0 -X log on || { echo 'AUTOPILOT_FAIL: SCREEN_LOG_ENABLE_FAILED'; false; }; pgrep -f '[q]emu-rnd-helper' >/dev/null 2>&1 || { echo 'AUTOPILOT_FAIL: QEMU_RND_HELPER_NOT_RUNNING'; false; }; echo \"AUTOPILOT_INFO: VM1_SCREEN_LOG_TO=$TTY_DEV\"",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_first_rpc_or_cap"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_first_rpc_or_cap": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "qemu_not_running",
          "pattern": "AUTOPILOT_FAIL: QEMU_RND_HELPER_NOT_RUNNING",
          "source": "tty0",
          "next": "fail"
        },
        {
          "label": "ftrace_overflow",
          "pattern": "FTRACE: Storage full",
          "source": "tty0",
          "next": "emit_ftrace_overflow_marker"
        },
        {
          "label": "rpc_activity",
          "pattern": "rpc_run summary:|rpcdbg: resp\\[|rpcdbg: event\\[",
          "source": "tty0",
          "next": "wait_rpc_inactivity_or_overflow"
        }
      ],
      "on_timeout": "emit_dump_reason_hard_cap"
    },
    "wait_rpc_inactivity_or_overflow": {
      "type": "wait_pattern",
      "timeout_s": 20,
      "outcomes": [
        {
          "label": "ftrace_overflow",
          "pattern": "FTRACE: Storage full",
          "source": "tty0",
          "next": "emit_ftrace_overflow_marker"
        },
        {
          "label": "rpc_activity",
          "pattern": "rpc_run summary:|rpcdbg: resp\\[|rpcdbg: event\\[",
          "source": "tty0",
          "next": "wait_rpc_inactivity_or_overflow"
        }
      ],
      "on_timeout": "emit_dump_reason_rpc_inactivity"
    },
    "emit_dump_reason_rpc_inactivity": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_INFO: FTRACE_DUMP_REASON=RPC_INACTIVITY_20S'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "dump_ftrace"
        }
      ],
      "on_timeout": "fail"
    },
    "emit_dump_reason_hard_cap": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_INFO: FTRACE_DUMP_REASON=HARD_CAP_120S_NO_RPC'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "dump_ftrace"
        }
      ],
      "on_timeout": "fail"
    },
    "dump_ftrace": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_INFO: HYP_FTRACE_DUMP_CMD_BEGIN'; /usr/bin/hyp-ftrace-ctl dump; rc=$?; echo \"AUTOPILOT_INFO: HYP_FTRACE_DUMP_CMD_RC=${rc}\"; echo 'AUTOPILOT_INFO: HYP_FTRACE_DUMP_CMD_END'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_dump_ftrace_result"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_dump_ftrace_result": {
      "type": "wait_pattern",
      "start_from": "tail",
      "timeout_s": 20,
      "outcomes": [
        {
          "label": "dump_transfer_marker",
          "pattern": "=== BINARY TRANSFER START ===|TRACE_DUMP_TERMINAL:",
          "source": "tty0",
          "next": "pass"
        },
        {
          "label": "dump_failed",
          "pattern": "AUTOPILOT_FAIL: HYP_FTRACE_DUMP_CMD_FAILED|AUTOPILOT_FAIL: HYP_FTRACE_DUMP_",
          "source": "tty0",
          "next": "fail"
        },
        {
          "label": "dump_cmd_nonzero_rc",
          "pattern": "AUTOPILOT_INFO: HYP_FTRACE_DUMP_CMD_RC=[1-9][0-9]*",
          "source": "tty0",
          "next": "emit_dump_cmd_nonzero_rc_fail"
        }
      ],
      "on_timeout": "emit_dump_no_transfer_fail"
    },
    "emit_dump_cmd_nonzero_rc_fail": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_FAIL: HYP_FTRACE_DUMP_CMD_NONZERO_RC'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "emit_dump_no_transfer_fail": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_FAIL: HYP_FTRACE_DUMP_NO_TRANSFER_MARKER'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "emit_ftrace_overflow_marker": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_INFO: FTRACE_OVERFLOW_OBSERVED (storage full observed; kernel auto-dump expected)'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_dump_terminal_or_shell"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_dump_terminal_or_shell": {
      "type": "wait_pattern",
      "start_from": "tail",
      "timeout_s": 360,
      "outcomes": [
        {
          "label": "dump_terminal",
          "pattern": "TRACE_DUMP_TERMINAL:",
          "source": "tty0",
          "next": "pass"
        },
        {
          "label": "shell_prompt",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "pass"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    }
  }
}
