{
  "entry": "wait_vm0_login_or_shell",
  "steps": {
    "wait_vm0_login_or_shell": {
      "type": "wait_pattern",
      "timeout_s": 300,
      "outcomes": [
        {
          "label": "ftrace_overflow",
          "pattern": "FTRACE: Storage full",
          "source": "tty0",
          "next": "emit_ftrace_overflow_marker"
        },
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "arm_ftrace_late"
        },
        {
          "label": "driver_vm_login",
          "pattern": "driver-vm login:|login:",
          "source": "tty0",
          "next": "send_root_login"
        }
      ],
      "on_timeout": "fail"
    },
    "send_root_login": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "root",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_vm0_shell"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_vm0_shell": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "ftrace_overflow",
          "pattern": "FTRACE: Storage full",
          "source": "tty0",
          "next": "emit_ftrace_overflow_marker"
        },
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "arm_ftrace_late"
        }
      ],
      "on_timeout": "fail"
    },
    "arm_ftrace_late": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "/usr/bin/hyp-ftrace-ctl arm",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_arm_ftrace_result"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_arm_ftrace_result": {
      "type": "wait_pattern",
      "start_from": "tail",
      "timeout_s": 20,
      "outcomes": [
        {
          "label": "arm_failed",
          "pattern": "AUTOPILOT_FAIL: HYP_FTRACE_ARM_CMD_FAILED|AUTOPILOT_FAIL: HYP_FTRACE_ARM_",
          "source": "tty0",
          "next": "fail"
        },
        {
          "label": "shell_prompt",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "run_qemu_rnd_helper"
        }
      ],
      "on_timeout": "fail"
    },
    "run_qemu_rnd_helper": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "qemu-rnd-helper >/tmp/qemu-rnd-helper.log 2>&1 &",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_first_rpc_or_cap"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_first_rpc_or_cap": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "ftrace_overflow",
          "pattern": "FTRACE: Storage full",
          "source": "tty0",
          "next": "emit_ftrace_overflow_marker"
        },
        {
          "label": "rpc_activity",
          "pattern": "rpc_run summary:|rpcdbg: resp\\[|rpcdbg: event\\[",
          "source": "tty0",
          "next": "wait_rpc_inactivity_or_overflow"
        }
      ],
      "on_timeout": "emit_dump_reason_hard_cap"
    },
    "wait_rpc_inactivity_or_overflow": {
      "type": "wait_pattern",
      "timeout_s": 20,
      "outcomes": [
        {
          "label": "ftrace_overflow",
          "pattern": "FTRACE: Storage full",
          "source": "tty0",
          "next": "emit_ftrace_overflow_marker"
        },
        {
          "label": "rpc_activity",
          "pattern": "rpc_run summary:|rpcdbg: resp\\[|rpcdbg: event\\[",
          "source": "tty0",
          "next": "wait_rpc_inactivity_or_overflow"
        }
      ],
      "on_timeout": "emit_dump_reason_rpc_inactivity"
    },
    "emit_dump_reason_rpc_inactivity": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_INFO: FTRACE_DUMP_REASON=RPC_INACTIVITY_20S'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "dump_ftrace"
        }
      ],
      "on_timeout": "fail"
    },
    "emit_dump_reason_hard_cap": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_INFO: FTRACE_DUMP_REASON=HARD_CAP_120S_NO_RPC'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "dump_ftrace"
        }
      ],
      "on_timeout": "fail"
    },
    "dump_ftrace": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "/usr/bin/hyp-ftrace-ctl dump",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_dump_ftrace_result"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_dump_ftrace_result": {
      "type": "wait_pattern",
      "start_from": "tail",
      "timeout_s": 20,
      "outcomes": [
        {
          "label": "dump_failed",
          "pattern": "AUTOPILOT_FAIL: HYP_FTRACE_DUMP_CMD_FAILED|AUTOPILOT_FAIL: HYP_FTRACE_DUMP_",
          "source": "tty0",
          "next": "fail"
        },
        {
          "label": "shell_prompt",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "pass"
        }
      ],
      "on_timeout": "fail"
    },
    "emit_ftrace_overflow_marker": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_INFO: FTRACE_OVERFLOW_OBSERVED (storage full observed; kernel auto-dump expected)'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_dump_terminal_or_shell"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_dump_terminal_or_shell": {
      "type": "wait_pattern",
      "start_from": "tail",
      "timeout_s": 360,
      "outcomes": [
        {
          "label": "dump_terminal",
          "pattern": "TRACE_DUMP_TERMINAL:",
          "source": "tty0",
          "next": "pass"
        },
        {
          "label": "shell_prompt",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "pass"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    }
  }
}
