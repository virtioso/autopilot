{
  "entry": "wait_vm0_login_or_shell",
  "steps": {
    "wait_vm0_login_or_shell": {
      "type": "wait_pattern",
      "timeout_s": 300,
      "outcomes": [
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "run_qemu_rnd_helper"
        },
        {
          "label": "driver_vm_login",
          "pattern": "driver-vm login:|login:",
          "source": "tty0",
          "next": "send_root_login"
        }
      ],
      "on_timeout": "fail"
    },
    "send_root_login": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "root",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_vm0_shell"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_vm0_shell": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "run_qemu_rnd_helper"
        }
      ],
      "on_timeout": "fail"
    },
    "run_qemu_rnd_helper": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "TTY_DEV=$(tty); if ! command -v screen >/dev/null 2>&1; then echo 'AUTOPILOT_FAIL: SCREEN_NOT_FOUND'; false; fi; screen -S vm1-uservm -X quit >/dev/null 2>&1 || true; screen -dmS vm1-uservm /bin/sh -lc 'qemu-rnd-helper; rc=$?; echo \"AUTOPILOT_INFO: QEMU_RND_HELPER_EXIT_RC=${rc}\"; if [ \"${rc}\" -ne 0 ]; then echo \"AUTOPILOT_FAIL: QEMU_RND_HELPER_EXIT_NONZERO rc=${rc}\"; fi; exit \"${rc}\"'; sleep 1; screen -ls | grep -q '[.]vm1-uservm[[:space:]]' || { echo 'AUTOPILOT_FAIL: SCREEN_SESSION_START_FAILED'; false; }; screen -S vm1-uservm -p 0 -X logfile \"$TTY_DEV\" || { echo 'AUTOPILOT_FAIL: SCREEN_LOGFILE_SET_FAILED'; false; }; screen -S vm1-uservm -p 0 -X log on || { echo 'AUTOPILOT_FAIL: SCREEN_LOG_ENABLE_FAILED'; false; }; echo \"AUTOPILOT_INFO: VM1_SCREEN_LOG_TO=$TTY_DEV\"",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_trace_dump_complete"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_trace_dump_complete": {
      "type": "wait_pattern",
      "timeout_s": 360,
      "outcomes": [
        {
          "label": "qemu_exit_nonzero",
          "pattern": "AUTOPILOT_FAIL: QEMU_RND_HELPER_EXIT_NONZERO rc=[0-9]+",
          "source": "tty0",
          "next": "fail"
        },
        {
          "label": "trace_dump_complete",
          "pattern": "VIO_TRACE_DUMP_END",
          "source": "tty0",
          "next": "pass"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    }
  }
}
