{
  "entry": "wait_vm0_login_or_shell",
  "steps": {
    "wait_vm0_login_or_shell": {
      "type": "wait_pattern",
      "timeout_s": 300,
      "outcomes": [
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "run_qemu_rnd_helper"
        },
        {
          "label": "driver_vm_login",
          "pattern": "driver-vm login:|login:",
          "source": "tty0",
          "next": "send_root_login"
        }
      ],
      "on_timeout": "fail"
    },
    "send_root_login": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "root",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_vm0_shell"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_vm0_shell": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "tty0",
          "next": "run_qemu_rnd_helper"
        }
      ],
      "on_timeout": "fail"
    },
    "run_qemu_rnd_helper": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "QH_LOG=/tmp/qemu-rnd-helper.log; QH_RC=/tmp/qemu-rnd-helper.rc; rm -f \"$QH_RC\"; echo \"AUTOPILOT_INFO: QEMU_RND_HELPER_START\"; ( qemu-rnd-helper >\"$QH_LOG\" 2>&1; rc=$?; echo \"$rc\" > \"$QH_RC\"; echo \"AUTOPILOT_INFO: QEMU_RND_HELPER_EXIT_RC=$rc\"; if [ \"$rc\" -ne 0 ]; then echo \"AUTOPILOT_FAIL: QEMU_RND_HELPER_EXIT_NONZERO rc=$rc\"; tail -n 80 \"$QH_LOG\" | sed 's/^/AUTOPILOT_QEMU_ERR: /'; fi ) & qh_pid=$!; echo \"AUTOPILOT_INFO: QEMU_RND_HELPER_LAUNCHED pid=$qh_pid log=$QH_LOG rc_file=$QH_RC\"; sleep 1; if ! kill -0 \"$qh_pid\" 2>/dev/null; then if [ -f \"$QH_RC\" ]; then rc=$(cat \"$QH_RC\"); echo \"AUTOPILOT_INFO: QEMU_RND_HELPER_EARLY_EXIT rc=$rc\"; fi; fi",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_first_mmio_rpc_activity"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_first_mmio_rpc_activity": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "qemu_exit_nonzero",
          "pattern": "AUTOPILOT_FAIL: QEMU_RND_HELPER_EXIT_NONZERO rc=[0-9]+",
          "source": "tty0",
          "next": "fail"
        },
        {
          "label": "mmio_or_rpc_activity_seen",
          "pattern": "EV_MMIO_BEGIN|rpc_run summary:|rpcdbg: resp\\[|rpcdbg: event\\[|first_mmio_rpc_activity",
          "source": "tty0",
          "next": "wait_trace_dump_complete"
        },
        {
          "label": "trace_dump_complete",
          "pattern": "VIO_TRACE_DUMP_END",
          "source": "tty0",
          "next": "pass"
        }
      ],
      "on_timeout": "emit_no_mmio_rpc_activity_fail"
    },
    "emit_no_mmio_rpc_activity_fail": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_FAIL: VIO_TRACE_NO_MMIO_RPC_ACTIVITY_BEFORE_DUMP_WINDOW'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_trace_dump_complete": {
      "type": "wait_pattern",
      "timeout_s": 240,
      "outcomes": [
        {
          "label": "qemu_exit_nonzero",
          "pattern": "AUTOPILOT_FAIL: QEMU_RND_HELPER_EXIT_NONZERO rc=[0-9]+",
          "source": "tty0",
          "next": "fail"
        },
        {
          "label": "trace_dump_complete",
          "pattern": "VIO_TRACE_DUMP_END",
          "source": "tty0",
          "next": "pass"
        }
      ],
      "on_timeout": "emit_dump_not_completed_fail"
    },
    "emit_dump_not_completed_fail": {
      "type": "send_cmd",
      "source": "tty0",
      "cmd": "echo 'AUTOPILOT_FAIL: VIO_TRACE_DUMP_NOT_COMPLETED_AFTER_ACTIVITY'",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    }
  }
}
