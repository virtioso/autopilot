{
  "entry": "wait_vm_boot",
  "steps": {
    "wait_vm_boot": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "vm",
          "pattern": "Booting Linux|driver-vm login:|login:",
          "source": "tty1",
          "next": "pass"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    }
  }
}
