{
  "entry": "map_raw_ccplex",
  "steps": {
    "map_raw_ccplex": {
      "type": "map_source",
      "source": "tty0",
      "tty": "env:AUTOPILOT_TTY0",
      "log": "console/tty0.raw",
      "outcomes": [
        {
          "label": "ok",
          "next": "map_uarti_carrier"
        }
      ],
      "on_timeout": "fail"
    },
    "map_uarti_carrier": {
      "type": "map_source",
      "source": "tty1",
      "tty": "env:AUTOPILOT_TTY1",
      "log": "console/tty1.raw",
      "outcomes": [
        {
          "label": "ok",
          "next": "window_raw_ccplex"
        }
      ],
      "on_timeout": "fail"
    },
    "window_raw_ccplex": {
      "type": "map_window",
      "window": 1,
      "source": "tty0",
      "title": "RAW CCPLEX",
      "outcomes": [
        {
          "label": "ok",
          "next": "window_uarti_carrier"
        }
      ],
      "on_timeout": "fail"
    },
    "window_uarti_carrier": {
      "type": "map_window",
      "window": 2,
      "source": "tty1",
      "title": "UARTI MUX",
      "outcomes": [
        {
          "label": "ok",
          "next": "purge_uarts"
        }
      ],
      "on_timeout": "fail"
    },
    "purge_uarts": {
      "type": "purge_sources",
      "sources": [
        "tty0",
        "tty1"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "run_vm_deploy_and_boot"
        }
      ],
      "on_timeout": "fail"
    },
    "run_vm_deploy_and_boot": {
      "type": "call_chain",
      "chain": "deploy_and_boot_test_efi",
      "outcomes": [
        {
          "label": "pass",
          "next": "wait_for_elfloader"
        },
        {
          "label": "fail",
          "next": "filter_logs_fail"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "wait_for_elfloader": {
      "type": "call_chain",
      "chain": "wait_for_elfloader",
      "outcomes": [
        {
          "label": "pass",
          "next": "start_virtioso_mux"
        },
        {
          "label": "fail",
          "next": "filter_logs_fail"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "start_virtioso_mux": {
      "type": "map_vcmux_source",
      "source": "virtioso_mux",
      "tty": "env:AUTOPILOT_TTY1",
      "log": "console/virtioso-mux.stdout.log",
      "virtioso_mux_path": "/home/hlyytine/tii-sel4/sources/virtioso-mux/host/virtioso-mux",
      "outer_mode": "raw",
      "replace_sources": [
        "tty1"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_console_registry"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "wait_console_registry": {
      "type": "wait_router_session",
      "source": "vm0",
      "timeout_s": 30,
      "outcomes": [
        {
          "label": "ok",
          "next": "open_guest_console_panes"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "open_guest_console_panes": {
      "type": "map_router_session_panes",
      "window": 3,
      "title": "Autopilot + Guest Consoles",
      "include_status_pane": true,
      "status_title": "Autopilot",
      "layout": "status-top",
      "status_rows": 12,
      "include_patterns": [
        "vm[0-9]*"
      ],
      "only_interactive": true,
      "max_panes": 8,
      "outcomes": [
        {
          "label": "ok",
          "next": "parallel_vm_boot_split"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "parallel_vm_boot_split": {
      "type": "call_chain",
      "chain": "vm_wait_boot",
      "outcomes": [
        {
          "label": "pass",
          "next": "filter_logs_pass"
        },
        {
          "label": "fail",
          "next": "filter_logs_fail"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "filter_logs_pass": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "vm0_log=\"{result_dir}/console/console-runtime/virtioso_mux_logs/vm0.txt\"; vm1_log=\"{result_dir}/console/console-runtime/virtioso_mux_logs/vm1.txt\"; raw_log=\"{result_dir}/console/raw_ccplex.txt\"; if [ -f \"$vm0_log\" ]; then {code_root}/filter_capdl_start.py < \"$vm0_log\" > \"{result_dir}/console/vm0.filtered.log\"; elif [ -f \"$raw_log\" ]; then {code_root}/filter_capdl_start.py < \"$raw_log\" > \"{result_dir}/console/raw_ccplex.filtered.log\"; else : > \"{result_dir}/console/raw_ccplex.filtered.log\"; fi; if [ -f \"$vm1_log\" ]; then {code_root}/filter_vm_console.py < \"$vm1_log\" > \"{result_dir}/console/vm1.log\"; else : > \"{result_dir}/console/vm1.log\"; fi"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "set_verdict_pass"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "filter_logs_fail": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "vm0_log=\"{result_dir}/console/console-runtime/virtioso_mux_logs/vm0.txt\"; vm1_log=\"{result_dir}/console/console-runtime/virtioso_mux_logs/vm1.txt\"; raw_log=\"{result_dir}/console/raw_ccplex.txt\"; if [ -f \"$vm0_log\" ]; then {code_root}/filter_capdl_start.py < \"$vm0_log\" > \"{result_dir}/console/vm0.filtered.log\"; elif [ -f \"$raw_log\" ]; then {code_root}/filter_capdl_start.py < \"$raw_log\" > \"{result_dir}/console/raw_ccplex.filtered.log\"; else : > \"{result_dir}/console/raw_ccplex.filtered.log\"; fi; if [ -f \"$vm1_log\" ]; then {code_root}/filter_vm_console.py < \"$vm1_log\" > \"{result_dir}/console/vm1.log\"; else : > \"{result_dir}/console/vm1.log\"; fi; if [ ! -f \"$vm0_log\" ]; then printf \"\\nAUTOPILOT_FAIL: VM0_CONSOLE_PAYLOAD_MISSING (registry arrived but vm0 produced no bytes; see raw_ccplex.txt)\\n\" >> \"{result_dir}/console/autopilot.fail.log\"; elif ! grep -a -q \"ELF-loader started on CPU\" \"$vm0_log\"; then printf \"\\nAUTOPILOT_FAIL: VM0_CONSOLE_PAYLOAD_MISSING_ELFLOADER (generated VM0 stream lacks ELF-loader marker; see raw_ccplex.txt)\\n\" >> \"{result_dir}/console/autopilot.fail.log\"; elif grep -a -E -q \"KERNEL DATA ABORT!|Kernel entry via VCPUFault\" \"$vm0_log\" && { [ ! -f \"$vm1_log\" ] || ! grep -a -E -q \"Booting Linux|driver-vm login:|login:\" \"$vm1_log\"; }; then printf \"\\nAUTOPILOT_FAIL: VM0_KERNEL_ABORT_PRE_VM1 (data abort before VM1 boot evidence)\\n\" >> \"{result_dir}/console/autopilot.fail.log\"; fi"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "set_verdict_fail"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "set_verdict_pass": {
      "type": "set_test_verdict",
      "verdict": "pass",
      "outcomes": [
        {
          "label": "ok",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "set_verdict_fail": {
      "type": "set_test_verdict",
      "verdict": "fail",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    }
  }
}
