{
  "entry": "upload_efi",
  "steps": {
    "upload_efi": {
      "type": "upload_efi",
      "target_user": "root",
      "target_ip": "{target_ip}",
      "target_path": "/efiboot/{target_binary_name}",
      "outcomes": [
        { "label": "ok", "next": "reboot_efi" }
      ],
      "on_timeout": "fail"
    },
    "reboot_efi": {
      "type": "reboot",
      "method": "ssh",
      "target_user": "root",
      "target_ip": "{target_ip}",
      "outcomes": [
        { "label": "ok", "next": "boot_efi" }
      ],
      "on_timeout": "fail"
    },
    "boot_efi": {
      "type": "boot_efi",
      "source": "tty0",
      "mode": "test_efi",
      "outcomes": [
        { "label": "ok", "next": "pass" }
      ],
      "on_timeout": "fail"
    },
    "pass": { "type": "pass" },
    "fail": { "type": "fail" }
  }
}
