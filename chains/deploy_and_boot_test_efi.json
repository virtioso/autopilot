{
  "oracle": "sequence",
  "steps": [
    {
      "oracle": "ssh_command",
      "host": "$AUTOPILOT_TARGET_IP",
      "cmd": "mkdir -p /var/lib/virtioso-vm-images",
      "success_label": "ok"
    },
    {
      "oracle": "ssh_upload",
      "host": "$AUTOPILOT_TARGET_IP",
      "src": "$AUTOPILOT_ROOTFS_PATH",
      "dst": "/var/lib/virtioso-vm-images/vm-image-driver-vm-jetson-agx-orin.rootfs.ext4"
    },
    {
      "oracle": "ssh_upload",
      "host": "$AUTOPILOT_TARGET_IP",
      "src": "$AUTOPILOT_LOCAL_EFI_PATH",
      "dst": "$AUTOPILOT_REMOTE_EFI_PATH"
    },
    {
      "oracle": "relay",
      "action": "boot"
    },
    {
      "oracle": "timeout",
      "seconds": 360,
      "step": {
        "oracle": "uefi_shell_run",
        "stream": "tty0",
        "binary": "$AUTOPILOT_EFI_BINARY",
        "fs": "$AUTOPILOT_EFI_FS",
        "skip_menu": true,
        "shell_timeout_s": 120.0,
        "fs_timeout_s": 10.0
      }
    },
    {
      "oracle": "verdict",
      "label": "pass"
    }
  ]
}
