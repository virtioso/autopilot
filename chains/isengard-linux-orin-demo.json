{
  "oracle": "sequence",
  "steps": [
    {
      "oracle": "uart_source",
      "stream": "tty0",
      "device": "$AUTOPILOT_TTY0"
    },
    {
      "oracle": "relay",
      "action": "boot"
    },
    {
      "oracle": "chain_ref",
      "path": "chains/boot_stock_linux.json"
    },
    {
      "oracle": "chain_ref",
      "path": "chains/isengard_deploy_and_boot.json"
    },
    {
      "oracle": "repeat_poll",
      "success_label": "ok",
      "max_iter": 30,
      "backoff": 1.0,
      "step": {
        "oracle": "ssh_command",
        "host": "$AUTOPILOT_TARGET_IP",
        "cmd": "true",
        "success_label": "ok"
      }
    },
    {
      "oracle": "ssh_command",
      "host": "$AUTOPILOT_TARGET_IP",
      "cmd": "isengard-demo-start",
      "success_label": "ok"
    },
    {
      "oracle": "ssh_command",
      "host": "$AUTOPILOT_TARGET_IP",
      "cmd": "sleep 1 && echo '=== vcan0 ===' && ip link show vcan0 && echo '=== obj tree ===' && ls /obj/obj/isengard/ && echo '=== sequence ===' && cat /obj/obj/isengard/runtime/sequence && echo '=== status_word ===' && cat /obj/obj/isengard/can/status_word",
      "success_label": "ok"
    },
    {
      "oracle": "verdict",
      "label": "pass"
    }
  ]
}
