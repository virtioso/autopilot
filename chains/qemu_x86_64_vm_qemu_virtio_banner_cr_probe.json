{
  "entry": "verify_remote_qemu_host_ready",
  "steps": {
    "launch_runner": {
      "type": "map_command_source",
      "source": "tty0",
      "log": "console/tty0.raw",
      "env": {
        "VIRTIOSO_CONSOLE_ROUTER_USE_VM_PREFIX_DEMUX": "1",
        "VIRTIOSO_QEMU_SPLIT_MONITOR": "1"
      },
      "command": [
        "python3",
        "-u",
        "{workspace}/projects/virtioso-camkes-vm/tools/qemu_runner.py",
        "run-remote",
        "--target",
        "qemu_x86_64_defconfig",
        "--binary",
        "{original_binary}",
        "--console-runtime-dir",
        "{result_dir}/console"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_banner_or_login"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "wait_banner_or_login": {
      "type": "wait_pattern",
      "timeout_s": 420,
      "outcomes": [
        {
          "label": "runner_failed",
          "pattern": "QEMU_RUNNER_ERROR:|AUTOPILOT_FAIL: PROCESS_EXIT_NONZERO rc=[0-9]+",
          "source": "tty0",
          "next": "set_verdict_fail"
        },
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "driver_vm_console",
          "next": "set_verdict_pass"
        },
        {
          "label": "driver_vm_login",
          "pattern": "driver-vm login:|login:",
          "source": "driver_vm_console",
          "next": "send_root_login"
        },
        {
          "label": "driver_vm_banner",
          "pattern": "Poky \\(Yocto Project Reference Distro\\).*/dev/ttyS0",
          "source": "driver_vm_console",
          "next": "send_carriage_return"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "send_carriage_return": {
      "type": "send_cmd",
      "source": "driver_vm_console",
      "cmd": "",
      "suffix": "\r",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_login_after_cr"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "wait_login_after_cr": {
      "type": "wait_pattern",
      "timeout_s": 30,
      "outcomes": [
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "driver_vm_console",
          "next": "set_verdict_pass"
        },
        {
          "label": "driver_vm_login",
          "pattern": "driver-vm login:|login:",
          "source": "driver_vm_console",
          "next": "send_root_login"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "send_root_login": {
      "type": "send_cmd",
      "source": "driver_vm_console",
      "cmd": "root",
      "suffix": "\n",
      "outcomes": [
        {
          "label": "ok",
          "next": "wait_vm0_shell"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "wait_vm0_shell": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "driver_vm_shell",
          "pattern": "root@driver-vm:~#|root@.*:~#",
          "source": "driver_vm_console",
          "next": "set_verdict_pass"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "set_verdict_pass": {
      "type": "set_test_verdict",
      "verdict": "pass",
      "outcomes": [
        {
          "label": "ok",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "set_verdict_fail": {
      "type": "set_test_verdict",
      "verdict": "fail",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    },
    "verify_remote_qemu_host_ready": {
      "type": "ssh_wait_ready",
      "target_user": "hlyytine",
      "target_ip": "192.168.101.110",
      "cmd": "true",
      "per_try_timeout_s": 5,
      "total_timeout_s": 30,
      "retry_interval_s": 2,
      "outcomes": [
        {
          "label": "ok",
          "next": "launch_runner"
        }
      ],
      "on_timeout": "set_verdict_fail"
    }
  }
}
