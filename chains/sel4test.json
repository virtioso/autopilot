{
  "entry": "map_tty0",
  "steps": {
    "map_tty0": {
      "type": "map_source",
      "source": "tty0",
      "tty": "env:AUTOPILOT_TTY0",
      "log": "console/tty0.raw",
      "outcomes": [
        {
          "label": "ok",
          "next": "window1"
        }
      ],
      "on_timeout": "fail"
    },
    "window1": {
      "type": "map_window",
      "window": 1,
      "source": "tty0",
      "title": "TTY0",
      "outcomes": [
        {
          "label": "ok",
          "next": "relay_power"
        }
      ],
      "on_timeout": "fail"
    },
    "relay_power": {
      "type": "relay",
      "outcomes": [
        {
          "label": "ok",
          "next": "run_boot_stock"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_sel4": {
      "type": "wait_pattern",
      "timeout_s": 180,
      "outcomes": [
        {
          "label": "ok",
          "pattern": "seL4|ELF-loader",
          "source": "tty0",
          "next": "filter_sel4_log_pass"
        },
        {
          "label": "panic",
          "pattern": "Kernel panic|panic",
          "source": "tty0",
          "next": "filter_sel4_log_fail"
        }
      ],
      "on_timeout": "filter_sel4_log_fail"
    },
    "filter_sel4_log_pass": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "{code_root}/filter_sel4_start.py \"{binary_name}\" < \"{result_dir}/console/tty0.raw\" > \"{result_dir}/console/sel4.log\""
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "set_verdict_pass"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "filter_sel4_log_fail": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "{code_root}/filter_sel4_start.py \"{binary_name}\" < \"{result_dir}/console/tty0.raw\" > \"{result_dir}/console/sel4.log\""
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "set_verdict_fail"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "set_verdict_pass": {
      "type": "set_test_verdict",
      "verdict": "pass",
      "outcomes": [
        {
          "label": "ok",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "set_verdict_fail": {
      "type": "set_test_verdict",
      "verdict": "fail",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "relay_fallback_pass": {
      "type": "call_chain",
      "chain": "post_test_fallback_relay",
      "outcomes": [
        {
          "label": "pass",
          "next": "pass"
        },
        {
          "label": "fail",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "relay_fallback_fail": {
      "type": "call_chain",
      "chain": "post_test_fallback_relay",
      "outcomes": [
        {
          "label": "pass",
          "next": "fail"
        },
        {
          "label": "fail",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    },
    "run_bootefi": {
      "type": "call_chain",
      "chain": "deploy_and_boot_test_efi",
      "outcomes": [
        {
          "label": "pass",
          "next": "wait_sel4"
        },
        {
          "label": "fail",
          "next": "set_verdict_fail"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "run_boot_stock": {
      "type": "call_chain",
      "chain": "boot_stock_linux",
      "outcomes": [
        {
          "label": "pass",
          "next": "run_bootefi"
        },
        {
          "label": "fail",
          "next": "set_verdict_fail"
        }
      ],
      "on_timeout": "set_verdict_fail"
    }
  }
}
