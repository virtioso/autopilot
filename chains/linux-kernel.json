{
  "entry": "map_tty0",
  "steps": {
    "map_tty0": {
      "type": "map_source",
      "source": "tty0",
      "tty": "env:AUTOPILOT_TTY0",
      "log": "console/tty0.jsonl",
      "outcomes": [
        {
          "label": "ok",
          "next": "window1"
        }
      ],
      "on_timeout": "fail"
    },
    "window1": {
      "type": "map_window",
      "window": 1,
      "source": "tty0",
      "title": "TTY0",
      "outcomes": [
        {
          "label": "ok",
          "next": "relay_power"
        }
      ],
      "on_timeout": "fail"
    },
    "relay_power": {
      "type": "relay",
      "outcomes": [
        {
          "label": "ok",
          "next": "spawn_prepare_task"
        }
      ],
      "on_timeout": "fail"
    },
    "spawn_prepare_task": {
      "type": "task_spawn",
      "task": "prepare_next_run",
      "chain": "prepare_next_run_task",
      "outcomes": [
        {
          "label": "ok",
          "next": "run_boot_stock"
        }
      ],
      "on_timeout": "fail"
    },
    "interactive_stock": {
      "type": "interactive_console",
      "hold_open": false,
      "exit_after_shell": false,
      "sessions": [
        {
          "name": "tty0",
          "port": "env:AUTOPILOT_TTY0",
          "source": "tty0",
          "profile": "ubuntu-22"
        }
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "upload_kernel"
        }
      ],
      "on_timeout": "upload_kernel"
    },
    "upload_kernel": {
      "type": "upload_kernel",
      "target_user": "root",
      "target_ip": "{target_ip}",
      "target_path": "/boot/Image-{kernel_release}",
      "outcomes": [
        {
          "label": "ok",
          "next": "reboot_test"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "reboot_test": {
      "type": "reboot",
      "method": "ssh",
      "target_user": "root",
      "target_ip": "{target_ip}",
      "outcomes": [
        {
          "label": "ok",
          "next": "boot_test"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "boot_test": {
      "type": "boot_menu",
      "source": "tty0",
      "boot_option": "2",
      "outcomes": [
        {
          "label": "menu",
          "pattern": "Press any .*boot default|Press ESCAPE for boot options|Enter to continue boot",
          "source": "tty0",
          "next": "wait_kernel"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "wait_kernel": {
      "type": "wait_pattern",
      "timeout_s": 300,
      "outcomes": [
        {
          "label": "panic",
          "pattern": "Kernel panic",
          "source": "tty0",
          "next": "set_verdict_fail"
        },
        {
          "label": "smmu",
          "pattern": "Unexpected global fault|callbacks suppressed",
          "source": "tty0",
          "next": "set_verdict_fail"
        },
        {
          "label": "shell",
          "pattern": "ubuntu@tegra-ubuntu:~\\$|tegra-ubuntu login:",
          "source": "tty0",
          "next": "set_verdict_pass"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "set_verdict_pass": {
      "type": "set_test_verdict",
      "verdict": "pass",
      "outcomes": [
        {
          "label": "ok",
          "next": "signal_prepare_pass"
        }
      ],
      "on_timeout": "signal_prepare_pass"
    },
    "set_verdict_fail": {
      "type": "set_test_verdict",
      "verdict": "fail",
      "outcomes": [
        {
          "label": "ok",
          "next": "signal_prepare_fail"
        }
      ],
      "on_timeout": "signal_prepare_fail"
    },
    "signal_prepare_pass": {
      "type": "signal_set",
      "signal": "prepare_next_run_go",
      "outcomes": [
        {
          "label": "ok",
          "next": "join_prepare_pass"
        }
      ],
      "on_timeout": "join_prepare_pass"
    },
    "join_prepare_pass": {
      "type": "task_join",
      "tasks": [
        "prepare_next_run"
      ],
      "reduce": "all_pass",
      "timeout_s": 240,
      "outcomes": [
        {
          "label": "pass",
          "next": "pass"
        },
        {
          "label": "fail",
          "next": "relay_fallback_pass"
        }
      ],
      "on_timeout": "relay_fallback_pass"
    },
    "signal_prepare_fail": {
      "type": "signal_set",
      "signal": "prepare_next_run_go",
      "outcomes": [
        {
          "label": "ok",
          "next": "join_prepare_fail"
        }
      ],
      "on_timeout": "join_prepare_fail"
    },
    "join_prepare_fail": {
      "type": "task_join",
      "tasks": [
        "prepare_next_run"
      ],
      "reduce": "all_pass",
      "timeout_s": 240,
      "outcomes": [
        {
          "label": "pass",
          "next": "fail"
        },
        {
          "label": "fail",
          "next": "relay_fallback_fail"
        }
      ],
      "on_timeout": "relay_fallback_fail"
    },
    "relay_fallback_pass": {
      "type": "relay",
      "outcomes": [
        {
          "label": "ok",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "relay_fallback_fail": {
      "type": "relay",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    },
    "run_boot_stock": {
      "type": "call_chain",
      "chain": "boot_stock_linux",
      "outcomes": [
        {
          "label": "pass",
          "next": "interactive_stock"
        },
        {
          "label": "fail",
          "next": "set_verdict_fail"
        }
      ],
      "on_timeout": "set_verdict_fail"
    }
  }
}
