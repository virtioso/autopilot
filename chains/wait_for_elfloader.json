{
  "entry": "wait_for_elfloader",
  "steps": {
    "wait_for_elfloader": {
      "type": "case",
      "source": "tty0",
      "start_from": "tail",
      "timeout_s": 300,
      "clauses": [
        {
          "label": "skip_whitespace",
          "pattern": "^\\s+",
          "next": "self"
        },
        {
          "label": "skip_efi_command_echo",
          "pattern": "^\\s*fs2:\\\\efiboot\\\\\\S*",
          "next": "self"
        },
        {
          "label": "elfloader",
          "pattern": "^ELF-loader started on CPU",
          "next": "pass"
        },
        {
          "label": "binary_not_uploaded",
          "pattern": "^.*is not recognized as an internal or external command",
          "next": "emit_binary_not_uploaded_fail"
        },
        {
          "label": "ignore_other_non_whitespace",
          "pattern": "^\\S+",
          "next": "self"
        }
      ],
      "on_timeout": "fail"
    },
    "emit_binary_not_uploaded_fail": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "printf \"\\nAUTOPILOT_FAIL: BINARY_NOT_UPLOADED (UEFI shell reported command not recognized)\\n\" >> \"{result_dir}/console/autopilot.fail.log\""
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    }
  }
}
