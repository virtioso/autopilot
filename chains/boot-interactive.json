{
  "entry": "map_tty0",
  "steps": {
    "map_tty0": {
      "type": "map_source",
      "source": "tty0",
      "tty": "env:AUTOPILOT_TTY0",
      "log": "console/tty0.jsonl",
      "outcomes": [
        {
          "label": "ok",
          "next": "window1"
        }
      ],
      "on_timeout": "fail"
    },
    "window1": {
      "type": "map_window",
      "window": 1,
      "source": "tty0",
      "title": "TTY0",
      "outcomes": [
        {
          "label": "ok",
          "next": "relay_power"
        }
      ],
      "on_timeout": "fail"
    },
    "relay_power": {
      "type": "relay",
      "outcomes": [
        {
          "label": "ok",
          "next": "spawn_prepare_task"
        }
      ],
      "on_timeout": "fail"
    },
    "spawn_prepare_task": {
      "type": "task_spawn",
      "task": "prepare_next_run",
      "chain": "prepare_next_run_task",
      "outcomes": [
        {
          "label": "ok",
          "next": "boot_stock"
        }
      ],
      "on_timeout": "fail"
    },
    "boot_stock": {
      "type": "boot_menu",
      "source": "tty0",
      "boot_option": "1",
      "outcomes": [
        {
          "label": "menu",
          "pattern": "Press any .*boot default|Press ESCAPE for boot options|Enter to continue boot",
          "source": "tty0",
          "next": "wait_stock_prompt"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_stock_prompt": {
      "type": "wait_pattern",
      "timeout_s": 180,
      "outcomes": [
        {
          "label": "prompt",
          "pattern": "ubuntu@tegra-ubuntu:~\\$|tegra-ubuntu login:",
          "source": "tty0",
          "next": "interactive"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "interactive": {
      "type": "interactive_console",
      "exit_after_shell": true,
      "hold_open": true,
      "sessions": [
        {
          "name": "tty0",
          "port": "env:AUTOPILOT_TTY0",
          "source": "tty0",
          "profile": "ubuntu-22"
        }
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "set_verdict_pass"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "set_verdict_pass": {
      "type": "set_test_verdict",
      "verdict": "pass",
      "outcomes": [
        {
          "label": "ok",
          "next": "signal_prepare_pass"
        }
      ],
      "on_timeout": "signal_prepare_pass"
    },
    "set_verdict_fail": {
      "type": "set_test_verdict",
      "verdict": "fail",
      "outcomes": [
        {
          "label": "ok",
          "next": "signal_prepare_fail"
        }
      ],
      "on_timeout": "signal_prepare_fail"
    },
    "signal_prepare_pass": {
      "type": "signal_set",
      "signal": "prepare_next_run_go",
      "outcomes": [
        {
          "label": "ok",
          "next": "join_prepare_pass"
        }
      ],
      "on_timeout": "join_prepare_pass"
    },
    "join_prepare_pass": {
      "type": "task_join",
      "tasks": [
        "prepare_next_run"
      ],
      "reduce": "all_pass",
      "timeout_s": 240,
      "outcomes": [
        {
          "label": "pass",
          "next": "pass"
        },
        {
          "label": "fail",
          "next": "relay_fallback_pass"
        }
      ],
      "on_timeout": "relay_fallback_pass"
    },
    "signal_prepare_fail": {
      "type": "signal_set",
      "signal": "prepare_next_run_go",
      "outcomes": [
        {
          "label": "ok",
          "next": "join_prepare_fail"
        }
      ],
      "on_timeout": "join_prepare_fail"
    },
    "join_prepare_fail": {
      "type": "task_join",
      "tasks": [
        "prepare_next_run"
      ],
      "reduce": "all_pass",
      "timeout_s": 240,
      "outcomes": [
        {
          "label": "pass",
          "next": "fail"
        },
        {
          "label": "fail",
          "next": "relay_fallback_fail"
        }
      ],
      "on_timeout": "relay_fallback_fail"
    },
    "relay_fallback_pass": {
      "type": "relay",
      "outcomes": [
        {
          "label": "ok",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "relay_fallback_fail": {
      "type": "relay",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    }
  }
}
