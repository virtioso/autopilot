{
  "entry": "set_overrides",
  "steps": {
    "set_overrides": {
      "type": "set_overrides",
      "overrides": {
        "chain_aliases": {
          "post_test_fallback_relay": "post_test_fallback_noop",
          "vm_common": "vm_common_orin_tcu_muxer"
        },
        "lifecycle": {
          "prepare": {
            "probe_chain": "boot_stock_linux",
            "run_chain": "recovery_boot",
            "max_retries": 3,
            "degraded_holds_queue": true
          }
        }
      },
      "outcomes": [
        { "label": "ok", "next": "pass" }
      ],
      "on_timeout": "fail"
    },
    "pass": { "type": "pass" },
    "fail": { "type": "fail" }
  }
}
