{
  "entry": "map_tty0",
  "steps": {
    "map_tty0": {
      "type": "map_source",
      "source": "tty0",
      "tty": "env:AUTOPILOT_TTY0",
      "log": "console/tty0.raw",
      "outcomes": [
        {
          "label": "ok",
          "next": "map_tty1"
        }
      ],
      "on_timeout": "fail"
    },
    "map_tty1": {
      "type": "map_source",
      "source": "tty1",
      "tty": "env:AUTOPILOT_TTY1",
      "log": "console/tty1.raw",
      "outcomes": [
        {
          "label": "ok",
          "next": "window1"
        }
      ],
      "on_timeout": "fail"
    },
    "window1": {
      "type": "map_window",
      "window": 1,
      "source": "tty0",
      "title": "TTY0",
      "outcomes": [
        {
          "label": "ok",
          "next": "window2"
        }
      ],
      "on_timeout": "fail"
    },
    "window2": {
      "type": "map_window",
      "window": 2,
      "source": "tty1",
      "title": "TTY1",
      "outcomes": [
        {
          "label": "ok",
          "next": "purge_uarts"
        }
      ],
      "on_timeout": "fail"
    },
    "purge_uarts": {
      "type": "purge_sources",
      "sources": [
        "tty0",
        "tty1"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "run_vm_deploy_and_boot"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_for_elfloader": {
      "type": "call_chain",
      "chain": "wait_for_elfloader",
      "outcomes": [
        {
          "label": "pass",
          "next": "start_tcu_muxer"
        },
        {
          "label": "fail",
          "next": "filter_logs_fail"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "start_tcu_muxer": {
      "type": "map_tcu_mux_source",
      "source": "tcu_muxer",
      "tty": "env:AUTOPILOT_TTY0",
      "log": "console/tcu_muxer.stdout.log",
      "tcu_muxer_path": "/home/hlyytine/tii-sel4/sources/tcu_muxer/tcu_muxer",
      "outer_mode": "nvidia-tcu",
      "outer_tag": "CCPLEX",
      "replace_sources": [
        "tty0",
        "tty1"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "parallel_vm_boot_split"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "parallel_vm_boot_split": {
      "type": "call_chain",
      "chain": "vm_wait_boot",
      "outcomes": [
        {
          "label": "pass",
          "next": "filter_logs_pass"
        },
        {
          "label": "fail",
          "next": "filter_logs_fail"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "filter_logs_pass": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "vm0_log=\"{result_dir}/console/console-runtime/tcu_muxer_logs/vm0_guest_console_sink.txt\"; vm1_log=\"{result_dir}/console/console-runtime/tcu_muxer_logs/vm1_guest_console_sink.txt\"; if [ -f \"$vm0_log\" ]; then {code_root}/filter_capdl_start.py < \"$vm0_log\" > \"{result_dir}/console/vm0_guest_console_sink.filtered.log\"; else : > \"{result_dir}/console/vm0_guest_console_sink.filtered.log\"; fi; if [ -f \"$vm1_log\" ]; then {code_root}/filter_vm_console.py < \"$vm1_log\" > \"{result_dir}/console/vm1_guest_console_sink.log\"; else : > \"{result_dir}/console/vm1_guest_console_sink.log\"; fi"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "set_verdict_pass"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "filter_logs_fail": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "vm0_log=\"{result_dir}/console/console-runtime/tcu_muxer_logs/vm0_guest_console_sink.txt\"; vm1_log=\"{result_dir}/console/console-runtime/tcu_muxer_logs/vm1_guest_console_sink.txt\"; if [ -f \"$vm0_log\" ]; then {code_root}/filter_capdl_start.py < \"$vm0_log\" > \"{result_dir}/console/vm0_guest_console_sink.filtered.log\"; else : > \"{result_dir}/console/vm0_guest_console_sink.filtered.log\"; fi; if [ -f \"$vm1_log\" ]; then {code_root}/filter_vm_console.py < \"$vm1_log\" > \"{result_dir}/console/vm1_guest_console_sink.log\"; else : > \"{result_dir}/console/vm1_guest_console_sink.log\"; fi; if [ ! -f \"$vm0_log\" ] || ! grep -a -q \"ELF-loader started on CPU\" \"$vm0_log\"; then printf \"\\nAUTOPILOT_FAIL: ELFLOADER_NOT_REACHED (missing ELF-loader start marker within timeout)\\n\" >> \"{result_dir}/console/autopilot.fail.log\"; elif grep -a -E -q \"KERNEL DATA ABORT!|Kernel entry via VCPUFault\" \"$vm0_log\" && { [ ! -f \"$vm1_log\" ] || ! grep -a -E -q \"Booting Linux|driver-vm login:|login:\" \"$vm1_log\"; }; then printf \"\\nAUTOPILOT_FAIL: VM0_KERNEL_ABORT_PRE_VM1 (data abort before VM1 boot evidence)\\n\" >> \"{result_dir}/console/autopilot.fail.log\"; fi"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "set_verdict_fail"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "set_verdict_pass": {
      "type": "set_test_verdict",
      "verdict": "pass",
      "outcomes": [
        {
          "label": "ok",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "set_verdict_fail": {
      "type": "set_test_verdict",
      "verdict": "fail",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "relay_fallback_pass": {
      "type": "call_chain",
      "chain": "post_test_fallback_noop",
      "outcomes": [
        {
          "label": "pass",
          "next": "pass"
        },
        {
          "label": "fail",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "relay_fallback_fail": {
      "type": "call_chain",
      "chain": "post_test_fallback_noop",
      "outcomes": [
        {
          "label": "pass",
          "next": "fail"
        },
        {
          "label": "fail",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    },
    "run_vm_deploy_and_boot": {
      "type": "call_chain",
      "chain": "vm_deploy_and_boot",
      "outcomes": [
        {
          "label": "pass",
          "next": "wait_for_elfloader"
        },
        {
          "label": "fail",
          "next": "set_verdict_fail"
        }
      ],
      "on_timeout": "set_verdict_fail"
    }
  }
}
