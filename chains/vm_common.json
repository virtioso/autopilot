{
  "entry": "map_tty0",
  "steps": {
    "map_tty0": {
      "type": "map_source",
      "source": "tty0",
      "tty": "env:AUTOPILOT_TTY0",
      "log": "console/tty0.raw",
      "outcomes": [
        {
          "label": "ok",
          "next": "map_tty1"
        }
      ],
      "on_timeout": "fail"
    },
    "map_tty1": {
      "type": "map_source",
      "source": "tty1",
      "tty": "env:AUTOPILOT_TTY1",
      "log": "console/tty1.raw",
      "outcomes": [
        {
          "label": "ok",
          "next": "window1"
        }
      ],
      "on_timeout": "fail"
    },
    "window1": {
      "type": "map_window",
      "window": 1,
      "source": "tty0",
      "title": "TTY0",
      "outcomes": [
        {
          "label": "ok",
          "next": "window2"
        }
      ],
      "on_timeout": "fail"
    },
    "window2": {
      "type": "map_window",
      "window": 2,
      "source": "tty1",
      "title": "TTY1",
      "outcomes": [
        {
          "label": "ok",
          "next": "purge_uarts"
        }
      ],
      "on_timeout": "fail"
    },
    "purge_uarts": {
      "type": "purge_sources",
      "sources": [
        "tty0",
        "tty1"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "run_vm_deploy_and_boot"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_for_elfloader": {
      "type": "case",
      "source": "tty0",
      "start_from": "tail",
      "timeout_s": 300,
      "clauses": [
        {
          "label": "skip_whitespace",
          "pattern": "^\\s+",
          "next": "self"
        },
        {
          "label": "skip_efi_command_echo",
          "pattern": "^\\s*fs2:\\\\efiboot\\\\[^\\r\\n]*\\.[Ee][Ff][Ii]\\s*(?:\\r?\\n|$)",
          "next": "self"
        },
        {
          "label": "elfloader",
          "pattern": "^ELF-loader started on CPU.*(?:\\r?\\n|$)",
          "next": "parallel_vm_boot_split"
        },
        {
          "label": "unexpected_non_whitespace",
          "pattern": "^\\S.*(?:\\r?\\n|$)",
          "next": "filter_logs_fail"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "parallel_vm_boot_split": {
      "type": "split",
      "group": "vm_boot_and_ftrace_watch",
      "branches": [
        {
          "name": "main_vm_boot",
          "chain": "vm_wait_boot"
        },
        {
          "name": "ftrace_watchdog",
          "chain": "monitor_ftrace_storage_full",
          "monitor": true
        }
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "parallel_vm_boot_join"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "parallel_vm_boot_join": {
      "type": "join",
      "join_groups": [
        "vm_boot_and_ftrace_watch"
      ],
      "reduce": "any_pass",
      "timeout_s": 300,
      "outcomes": [
        {
          "label": "pass",
          "next": "filter_logs_pass"
        },
        {
          "label": "fail",
          "next": "filter_logs_fail"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "filter_logs_pass": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "{code_root}/filter_capdl_start.py < \"{result_dir}/console/tty0.raw\" > \"{result_dir}/console/sel4.log\" && {code_root}/filter_vm_console.py < \"{result_dir}/console/tty1.raw\" > \"{result_dir}/console/vm.log\""
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "set_verdict_pass"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "filter_logs_fail": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "{code_root}/filter_capdl_start.py < \"{result_dir}/console/tty0.raw\" > \"{result_dir}/console/sel4.log\" && {code_root}/filter_vm_console.py < \"{result_dir}/console/tty1.raw\" > \"{result_dir}/console/vm.log\"; if ! grep -a -q \"ELF-loader started on CPU\" \"{result_dir}/console/tty0.raw\"; then printf \"\\nAUTOPILOT_FAIL: ELFLOADER_NOT_REACHED (missing ELF-loader start marker within timeout)\\n\" >> \"{result_dir}/console/sel4.log\"; elif grep -a -q \"FTRACE: Storage full\" \"{result_dir}/console/tty0.raw\" && ! grep -a -E -q \"Booting Linux|driver-vm login:|login:\" \"{result_dir}/console/tty1.raw\"; then printf \"\\nAUTOPILOT_FAIL: FTRACE_OVERFLOW_EARLY (storage full before VM1 boot evidence)\\n\" >> \"{result_dir}/console/sel4.log\"; elif grep -a -E -q \"KERNEL DATA ABORT!|Kernel entry via VCPUFault\" \"{result_dir}/console/tty0.raw\" && ! grep -a -E -q \"Booting Linux|driver-vm login:|login:\" \"{result_dir}/console/tty1.raw\"; then printf \"\\nAUTOPILOT_FAIL: VM0_KERNEL_ABORT_PRE_VM1 (data abort before VM1 boot evidence)\\n\" >> \"{result_dir}/console/sel4.log\"; fi"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "set_verdict_fail"
        }
      ],
      "on_timeout": "set_verdict_fail"
    },
    "set_verdict_pass": {
      "type": "set_test_verdict",
      "verdict": "pass",
      "outcomes": [
        {
          "label": "ok",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "set_verdict_fail": {
      "type": "set_test_verdict",
      "verdict": "fail",
      "outcomes": [
        {
          "label": "ok",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "relay_fallback_pass": {
      "type": "call_chain",
      "chain": "post_test_fallback_noop",
      "outcomes": [
        {
          "label": "pass",
          "next": "pass"
        },
        {
          "label": "fail",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "relay_fallback_fail": {
      "type": "call_chain",
      "chain": "post_test_fallback_noop",
      "outcomes": [
        {
          "label": "pass",
          "next": "fail"
        },
        {
          "label": "fail",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    },
    "run_vm_deploy_and_boot": {
      "type": "call_chain",
      "chain": "vm_deploy_and_boot",
      "outcomes": [
        {
          "label": "pass",
          "next": "wait_for_elfloader"
        },
        {
          "label": "fail",
          "next": "set_verdict_fail"
        }
      ],
      "on_timeout": "set_verdict_fail"
    }
  }
}
