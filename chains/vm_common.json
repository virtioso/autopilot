{
  "entry": "map_tty0",
  "steps": {
    "map_tty0": {
      "type": "map_source",
      "source": "tty0",
      "tty": "env:AUTOPILOT_TTY0",
      "log": "console/tty0.raw",
      "outcomes": [
        {
          "label": "ok",
          "next": "map_tty1"
        }
      ],
      "on_timeout": "fail"
    },
    "map_tty1": {
      "type": "map_source",
      "source": "tty1",
      "tty": "env:AUTOPILOT_TTY1",
      "log": "console/tty1.raw",
      "outcomes": [
        {
          "label": "ok",
          "next": "window1"
        }
      ],
      "on_timeout": "fail"
    },
    "window1": {
      "type": "map_window",
      "window": 1,
      "source": "tty0",
      "title": "TTY0",
      "outcomes": [
        {
          "label": "ok",
          "next": "window2"
        }
      ],
      "on_timeout": "fail"
    },
    "window2": {
      "type": "map_window",
      "window": 2,
      "source": "tty1",
      "title": "TTY1",
      "outcomes": [
        {
          "label": "ok",
          "next": "relay_power"
        }
      ],
      "on_timeout": "fail"
    },
    "relay_power": {
      "type": "relay",
      "outcomes": [
        {
          "label": "ok",
          "next": "run_bootefi"
        }
      ],
      "on_timeout": "fail"
    },
    "wait_capdl": {
      "type": "wait_pattern",
      "timeout_s": 120,
      "outcomes": [
        {
          "label": "ftrace_overflow",
          "pattern": "FTRACE: Storage full",
          "source": "tty0",
          "next": "filter_logs_fail_ftrace_overflow"
        },
        {
          "label": "kernel_data_abort",
          "pattern": "KERNEL DATA ABORT!|Kernel entry via VCPUFault",
          "source": "tty0",
          "next": "filter_logs_fail_vm0_abort"
        },
        {
          "label": "capdl",
          "pattern": "capdl-loader|ELF-loader",
          "source": "tty0",
          "next": "wait_vm_boot"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "wait_vm_boot": {
      "type": "call_chain",
      "chain": "vm_wait_boot",
      "outcomes": [
        {
          "label": "pass",
          "next": "filter_logs_pass"
        },
        {
          "label": "fail",
          "next": "filter_logs_fail"
        }
      ],
      "on_timeout": "filter_logs_fail"
    },
    "filter_logs_pass": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "{code_root}/filter_capdl_start.py < \"{result_dir}/console/tty0.raw\" > \"{result_dir}/console/sel4.log\" && {code_root}/filter_vm_console.py < \"{result_dir}/console/tty1.raw\" > \"{result_dir}/console/vm.log\""
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "fork_recovery_pass"
        }
      ],
      "on_timeout": "fork_recovery_fail"
    },
    "filter_logs_fail": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "{code_root}/filter_capdl_start.py < \"{result_dir}/console/tty0.raw\" > \"{result_dir}/console/sel4.log\" && {code_root}/filter_vm_console.py < \"{result_dir}/console/tty1.raw\" > \"{result_dir}/console/vm.log\"; if grep -a -q \"FTRACE: Storage full\" \"{result_dir}/console/tty0.raw\" && ! grep -a -E -q \"Booting Linux|driver-vm login:|login:\" \"{result_dir}/console/tty1.raw\"; then printf \"\\nAUTOPILOT_FAIL: FTRACE_OVERFLOW_EARLY (storage full before VM1 boot evidence)\\n\" >> \"{result_dir}/console/sel4.log\"; elif grep -a -E -q \"KERNEL DATA ABORT!|Kernel entry via VCPUFault\" \"{result_dir}/console/tty0.raw\" && ! grep -a -E -q \"Booting Linux|driver-vm login:|login:\" \"{result_dir}/console/tty1.raw\"; then printf \"\\nAUTOPILOT_FAIL: VM0_KERNEL_ABORT_PRE_VM1 (data abort before VM1 boot evidence)\\n\" >> \"{result_dir}/console/sel4.log\"; fi"
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "fork_recovery_fail"
        }
      ],
      "on_timeout": "fork_recovery_fail"
    },
    "filter_logs_fail_ftrace_overflow": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "{code_root}/filter_capdl_start.py < \"{result_dir}/console/tty0.raw\" > \"{result_dir}/console/sel4.log\" && {code_root}/filter_vm_console.py < \"{result_dir}/console/tty1.raw\" > \"{result_dir}/console/vm.log\"; printf \"\\nAUTOPILOT_FAIL: FTRACE_OVERFLOW_EARLY (storage full before VM1 boot evidence)\\n\" >> \"{result_dir}/console/sel4.log\""
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "fork_recovery_fail"
        }
      ],
      "on_timeout": "fork_recovery_fail"
    },
    "filter_logs_fail_vm0_abort": {
      "type": "analyze_logs",
      "command": [
        "bash",
        "-lc",
        "{code_root}/filter_capdl_start.py < \"{result_dir}/console/tty0.raw\" > \"{result_dir}/console/sel4.log\" && {code_root}/filter_vm_console.py < \"{result_dir}/console/tty1.raw\" > \"{result_dir}/console/vm.log\"; printf \"\\nAUTOPILOT_FAIL: VM0_KERNEL_ABORT_PRE_VM1 (data abort before VM1 boot evidence)\\n\" >> \"{result_dir}/console/sel4.log\""
      ],
      "outcomes": [
        {
          "label": "ok",
          "next": "fork_recovery_fail"
        }
      ],
      "on_timeout": "fork_recovery_fail"
    },
    "fork_recovery_pass": {
      "type": "fork",
      "chain": "recovery_boot",
      "outcomes": [
        {
          "label": "started",
          "next": "pass"
        }
      ],
      "on_timeout": "pass"
    },
    "fork_recovery_fail": {
      "type": "fork",
      "chain": "recovery_boot",
      "outcomes": [
        {
          "label": "started",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    },
    "pass": {
      "type": "pass"
    },
    "fail": {
      "type": "fail"
    },
    "run_bootefi": {
      "type": "call_chain",
      "chain": "bootefi_orin_netboot",
      "outcomes": [
        {
          "label": "pass",
          "next": "wait_capdl"
        },
        {
          "label": "fail",
          "next": "fail"
        }
      ],
      "on_timeout": "fail"
    }
  }
}
